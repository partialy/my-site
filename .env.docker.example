# Docker Compose 部署环境变量模板（复制为根目录 .env 后使用）

# 宿主机映射端口（均可在 1-65535 内自定义）
CLIENT_HOST_PORT=56080
ADMIN_HOST_PORT=56808
SERVER_HOST_PORT=56300

# 服务端安全密钥（生产环境务必替换，且不要以 replace-with- 开头）
JWT_SECRET=change-this-to-at-least-32-chars-jwt-secret
SETUP_KEY=change-this-setup-key-16chars

# 管理端访问来源（用于 CORS 校验，填写浏览器实际访问管理端的 Origin）
ADMIN_ORIGIN=http://localhost:56808

# 反代可信代理（容器反代场景建议保留 loopback,linklocal,uniquelocal）
TRUSTED_PROXIES=loopback,linklocal,uniquelocal

# 用户端站点规范 URL（用于 SEO canonical、sitemap.xml 与 Open Graph）
NEXT_PUBLIC_SITE_URL=http://localhost:56080
